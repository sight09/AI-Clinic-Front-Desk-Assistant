# ---------------------------------------------------------------------------
# AI Clinic Front-Desk Assistant — environment template
# Copy to `.env` and fill in values. NEVER commit the real `.env` file.
# All demo/seed data is synthetic. No real patient data may be used.
# ---------------------------------------------------------------------------

# PostgreSQL connection (required)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- LLM provider (server-side only, never expose to the browser) -----------
# Which provider the wrapper uses: "mock" (default, deterministic, no key
# needed — used for tests/demo) or "openai" (OpenAI-compatible HTTP API).
AI_PROVIDER=mock

# Required only when AI_PROVIDER=openai. Server-side secret — do not prefix
# with NEXT_PUBLIC_ and never log it.
AI_API_KEY=replace-me

# OpenAI-compatible endpoint and model (only used when AI_PROVIDER=openai)
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Network behaviour of the provider wrapper
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=2

# Seed/demo login password for the synthetic accounts created by db:seed
# (change for any shared environment; demo-only, never a real credential)
SEED_DEMO_PASSWORD=demo1234
